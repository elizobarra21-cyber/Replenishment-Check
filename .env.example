# Supabase Postgres - project "store-replenishment-eu"
# ref: vxxvndxzayywxzrtpkhe, region eu-central-1 (Frankfurt)
#
# Pooled connection (IPv4) for serverless / Vercel. Get the values from
# Supabase -> Connect -> ORMs -> Prisma (replace [YOUR-PASSWORD]).
#
# DATABASE_URL = transaction pooler (port 6543), used by the app at runtime.
DATABASE_URL="postgresql://postgres.vxxvndxzayywxzrtpkhe:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = session pooler (port 5432), used by prisma migrate / db push.
DIRECT_URL="postgresql://postgres.vxxvndxzayywxzrtpkhe:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth: secret used to sign session cookies. Set a long random value in prod.
SESSION_SECRET="change-me-to-a-long-random-string"

# Email report (optional, disabled until set). If RESEND_API_KEY is present the
# finish-session report is emailed via Resend; otherwise the PDF is only built.
# RESEND_API_KEY="re_..."
# REPORT_FROM="Store Replenishment <onboarding@resend.dev>"
# REPORT_TO="star00@list.ru"
