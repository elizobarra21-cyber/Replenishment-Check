# Supabase Postgres (project ref: dxrnrdcgqjlajiejwlkd, region eu-central-1)
#
# On Vercel these are provided automatically by the Supabase integration
# (Vercel -> Project -> Storage/Integrations -> Supabase). The app reads:
#   POSTGRES_PRISMA_URL      -> pooled connection (pgbouncer), used at runtime
#   POSTGRES_URL_NON_POOLING -> direct/session connection, used by prisma migrate / db push
#
# For LOCAL dev, copy those two values from the Vercel project's Environment
# Variables, or from Supabase -> Connect -> ORMs -> Prisma (replace [YOUR-PASSWORD]).
# Note the pooler host for this project is aws-1-eu-central-1.
POSTGRES_PRISMA_URL="postgresql://postgres.dxrnrdcgqjlajiejwlkd:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgresql://postgres.dxrnrdcgqjlajiejwlkd:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
