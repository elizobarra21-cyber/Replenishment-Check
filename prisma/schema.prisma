generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  DONE
}

/// Technical support for scanned products. Warehouse grouping uses RequestItem.storageSection.
model Section {
  id             String    @id @default(cuid())
  name           String
  warehouseOrder Int
  products       Product[]

  @@unique([name])
}

model SizeSystem {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  orderedSizes        Json
  targetQtyBySize     Json
  minDisplayItemCount Int       @default(5)
  products            Product[]
}

/// Technical record for scanned articles. This is not a merchandise catalog.
model Product {
  id           String     @id @default(cuid())
  article      String     @unique
  name         String
  sectionId    String
  sizeSystemId String
  section      Section    @relation(fields: [sectionId], references: [id])
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id])
  requestItems RequestItem[]
}

model User {
  id           String                 @id @default(cuid())
  username     String                 @unique
  passwordHash String?
  email        String?                @unique
  googleId     String?                @unique
  createdAt    DateTime               @default(now())
  requests     ReplenishmentRequest[]
}

/// Optional feedback on scan quality, collected for OCR debugging.
model ScanFeedback {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  rating         String
  ocrLine        String?
  article        String?
  color          String?
  season         String?
  storageSection String?
  labelPhotoUrl  String?
  userId         String?
}

model ReplenishmentRequest {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  createdBy String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  status    RequestStatus @default(DRAFT)
  items     RequestItem[]

  @@index([userId])
}

model RequestItem {
  id                  String               @id @default(cuid())
  requestId           String
  productId           String
  article             String
  color               String?
  colorName           String?
  season              String?
  storageSection      String?
  labelPhotoUrl       String?
  imageUrl            String?
  presentSizesQty     Json
  neededSizesQty      Json
  substitutePriority  Json
  pickedSizesQty      Json?
  pickStatus          String?
  warehouseNote       String?
  sizeSystem          String?
  frontSize           Int?
  createdAt           DateTime             @default(now())
  request             ReplenishmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])

  @@index([requestId])
}
