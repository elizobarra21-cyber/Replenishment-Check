generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  DONE
}

/// Technical support for scanned products. Warehouse grouping uses RequestItem.storageSection.
model Section {
  id             String    @id @default(cuid())
  name           String
  warehouseOrder Int
  products       Product[]

  @@unique([name])
}

model SizeSystem {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  orderedSizes        Json
  targetQtyBySize     Json
  minDisplayItemCount Int       @default(5)
  products            Product[]
}

/// Technical record for scanned articles. This is not a merchandise catalog.
model Product {
  id           String        @id @default(cuid())
  article      String        @unique
  name         String
  sectionId    String
  sizeSystemId String
  section      Section       @relation(fields: [sectionId], references: [id])
  sizeSystem   SizeSystem    @relation(fields: [sizeSystemId], references: [id])
  requestItems RequestItem[]
}

model User {
  id            String                 @id @default(cuid())
  username      String                 @unique
  passwordHash  String?
  email         String?                @unique
  /// True only when the email came from Google; Google sign-in links an
  /// existing account by email only if it is verified (a manually typed email
  /// must never let a Google login land in someone else's account).
  emailVerified Boolean                @default(false)
  googleId      String?                @unique
  /// Legacy personal layout, no longer read: rules now belong to the store.
  layout        Json?
  createdAt     DateTime               @default(now())
  /// Network administrator: creates stores and manages all of them.
  isNetworkAdmin Boolean               @default(false)
  /// May choose a store from the list. Accounts from before stores existed and
  /// anyone who joined through an invite link; new accounts need the link.
  canPickStore  Boolean                @default(false)
  defaultStoreId String?
  /// Where the user works right now (a shift can be in another store).
  activeStoreId String?
  requests      ReplenishmentRequest[]
  memberships   StoreMember[]
}

enum StoreRole {
  ADMIN
  MEMBER
}

model Store {
  id              String                 @id @default(cuid())
  name            String                 @unique
  inviteCode      String                 @unique
  /// Store rules: size grids and fronts; null = built-in defaults.
  /// Shape: SizeLayout in lib/replenishment.ts.
  layout          Json?
  layoutUpdatedAt DateTime?
  layoutUpdatedBy String?
  createdAt       DateTime               @default(now())
  members         StoreMember[]
  requests        ReplenishmentRequest[]
}

model StoreMember {
  userId   String
  storeId  String
  role     StoreRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

/// Optional feedback on scan quality, collected for OCR debugging.
model ScanFeedback {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  rating         String
  ocrLine        String?
  article        String?
  color          String?
  season         String?
  storageSection String?
  labelPhotoUrl  String?
  userId         String?
}

model ReplenishmentRequest {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  createdBy String
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  storeId   String?
  store     Store?        @relation(fields: [storeId], references: [id])
  status    RequestStatus @default(DRAFT)
  items     RequestItem[]

  @@index([userId])
  @@index([storeId])
}

model RequestItem {
  id                 String               @id @default(cuid())
  requestId          String
  productId          String
  article            String
  color              String?
  colorName          String?
  season             String?
  storageSection     String?
  labelPhotoUrl      String?
  imageUrl           String?
  presentSizesQty    Json
  neededSizesQty     Json
  substitutePriority Json
  pickedSizesQty     Json?
  pickStatus         String?
  warehouseNote      String?
  sizeSystem         String?
  frontSize          Int?
  /// Target (Y in X/Y) when the item was added, so a later change of the store
  /// rules does not rewrite history. Null on older items.
  targetTotal        Int?
  createdAt          DateTime             @default(now())
  request            ReplenishmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id])

  @@index([requestId])
}
