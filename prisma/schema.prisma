generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Injected by the Supabase x Vercel integration (pooled + direct).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  DONE
}

/// Technical support for scanned products. Warehouse grouping uses RequestItem.storageSection.
model Section {
  id             String    @id @default(cuid())
  name           String
  warehouseOrder Int
  products       Product[]

  @@unique([name])
}

model SizeSystem {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  orderedSizes        Json
  targetQtyBySize     Json
  minDisplayItemCount Int       @default(5)
  products            Product[]
}

/// Technical record for scanned articles. This is not a merchandise catalog.
model Product {
  id           String     @id @default(cuid())
  article      String     @unique
  name         String
  sectionId    String
  sizeSystemId String
  section      Section    @relation(fields: [sectionId], references: [id])
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id])
  requestItems RequestItem[]
}

model ReplenishmentRequest {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  createdBy String
  status    RequestStatus @default(DRAFT)
  items     RequestItem[]
}

model RequestItem {
  id                  String               @id @default(cuid())
  requestId           String
  productId           String
  article             String
  color               String?
  colorName           String?
  season              String?
  storageSection      String?
  labelPhotoUrl       String?
  presentSizesQty     Json
  neededSizesQty      Json
  substitutePriority  Json
  pickedSizesQty      Json?
  pickStatus          String?
  warehouseNote       String?
  createdAt           DateTime             @default(now())
  request             ReplenishmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])

  @@index([requestId])
}
